<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Credenciales ficticias: las pruebas nunca llaman a Stripe ni a SendGrid de verdad -->
        <env name="STRIPE_KEY" value="pk_test_cloudspace" force="true"/>
        <env name="STRIPE_SECRET" value="sk_test_cloudspace" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_cloudspace_pruebas" force="true"/>
        <env name="SENDGRID_API_KEY" value="SG.cloudspace-pruebas" force="true"/>
        <env name="SENDGRID_FROM_ADDRESS" value="pagos@cloudspace.test" force="true"/>
        <env name="SENDGRID_FROM_NAME" value="CloudSpace Solutions" force="true"/>
        <env name="SENDGRID_SANDBOX" value="false" force="true"/>
        <!-- Los logs de las pruebas solo van a la base de datos de pruebas, no a storage/logs -->
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="LOG_INTEGRACIONES_STACK" value="integraciones_bd" force="true"/>
    </php>
</phpunit>
